APP_NAME=SIBIMTA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# PostgreSQL lokal, atau isi DB_URL dengan connection string Neon
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sibimta
DB_USERNAME=postgres
DB_PASSWORD=
# DB_URL=postgresql://user:password@host/dbname?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack

# database = isi berkas disimpan di database (cocok untuk hosting gratis)
FILE_STORE=database
# Isi data contoh saat database masih kosong
SEED_DEMO=true
DEMO_PASSWORD=sibimta123
